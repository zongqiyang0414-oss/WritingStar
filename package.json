{
  "name": "writingstar",
  "version": "0.18.0",
  "scripts": {
    "build:h5": "uni build",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "type-check": "vue-tsc --noEmit",
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "dev": "uni --host 127.0.0.1 --port 5173",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/build-scan-worker.mjs && node scripts/prepare-weixin-preview.mjs && node scripts/verify-weixin-styles.mjs && node scripts/verify-weixin-state.cjs && node scripts/verify-weixin-scan.cjs && node scripts/verify-scan-worker.cjs",
    "dev:preview": "npm run dev",
    "test:preview": "node --test --test-isolation=none scripts/preview-regression-v091.cjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "build:preview": "npm run build:site",
    "build:site": "npm run build:h5 && node scripts/prepare-site.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/tsconfig": "^0.1.3",
    "typescript": "~5.7.3",
    "vite": "5.2.8",
    "vue-tsc": "~2.2.12",
    "tsx": "^4.20.5",
    "@babel/parser": "7.25.6",
    "@babel/generator": "7.29.8",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.25.6",
    "postcss": "8.5.29",
    "postcss-selector-parser": "6.1.2"
  },
  "private": true
}
