  await button('保存新密码并继续').click();
  assert.equal((await storage()).teacherAccount.mustChangePassword,false);
  await button('新建我的班级').waitFor();
  await button('新建我的班级').click();
  await button('＋ 新建班级', page.locator('.admin-workspace')).click();
  await input('例如：五年级（1）班').fill('五年级（27）班');
  await button(/^保存班级$/).click();
