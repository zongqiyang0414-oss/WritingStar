  assert.ok(studentAccount?.password);
  await page.screenshot({ path: 'outputs/v027-student-import.png', fullPage: true });
  await page.reload({ waitUntil: 'networkidle' });
  assert.equal((await storage()).students.filter(item => item.classId === schoolClass.id).length, 3);
  await button(/工作台/, page.locator('.bottom-nav')).click();
  await button(/布置作业/).click();
  await page.locator('.assignment-composer').waitFor();
  assert.match(await page.locator('.composer-title-input').innerText(),/请输入题目/);
  assert.match(await page.locator('.composer-requirements-input').innerText(),/选填/);
  await page.locator('.composer-title-input textarea').fill('观察生活中的形状与色彩');
  await page.locator('.composer-requirements-input textarea').fill('一、观察插图中的两种图形。\n二、写清形状和色彩的特点。\n三、联系生活中的一次发现，写一篇不少于300字的短文。');
  const [illustrationChooser] = await Promise.all([page.waitForEvent('filechooser'), button(/^添加插图$/).click()]);
  await illustrationChooser.setFiles('/tmp/writingstar-v027-illustration.png');
  await page.locator('.composer-illustration-preview').waitFor();
  await page.screenshot({ path: 'outputs/v027-composer.png', fullPage: true });
  await button(/^发布作业$/).click();
  await button('查看 / 打印答题卡').waitFor();
  state = await storage();
