  await button(/^批量导入$/).click();
  const importScope = page.locator('.student-import');
  await page.screenshot({path:'outputs/v027-roster-example.png',fullPage:true});
  async function importFile(path, count) {
    const [chooser] = await Promise.all([page.waitForEvent('filechooser'), button(/选择Word \/ Excel名单|重新选择名单文件/, importScope).click()]);
    await chooser.setFiles(path);
    await button(`确认导入${count}人并生成账号`, importScope).waitFor();
    assert.equal(await importScope.locator('.roster-preview-row').count(), count);
    await button(`确认导入${count}人并生成账号`, importScope).click();
    await importScope.getByText('账号已生成', { exact: true }).waitFor();
    assert.equal(await importScope.locator('.roster-account-grid:not(.roster-account-head)').count(), count);
  }
