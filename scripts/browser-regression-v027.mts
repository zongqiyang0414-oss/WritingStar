  const teacherAccount = state.loginCredentials.find(item => item.id === approved.credentialId);
  assert.equal(teacherAccount.username, '13800138027');
  assert.equal(teacherAccount.password, 'Aa123456');
  assert.equal(teacherAccount.mustChangePassword, true);
  await page.screenshot({ path: 'outputs/v027-application-review.png', fullPage: true });
  await button(/^账号登录$/, page.locator('.account-tabs')).click();
