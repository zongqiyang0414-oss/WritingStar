  await page.locator('.teacher-password-reset').waitFor();
  assert.equal(await page.locator('.bottom-nav').count(),0);
  await page.screenshot({path:'outputs/v027-first-password-reset.png',fullPage:true});
  await page.reload({waitUntil:'networkidle'});
  await page.locator('.teacher-password-reset').waitFor();
  await input('请输入初始密码').fill('Aa123456');
  await input('8—32位，包含字母和数字').fill('Newpass2027');
