  await page.locator('.assignment-card').filter({ hasText: assignment.title }).waitFor();
  assert.equal((await storage()).accounts.student.studentId, importedStudents[0].id);
  await page.screenshot({ path: 'outputs/v027-student-login.png', fullPage: true });
