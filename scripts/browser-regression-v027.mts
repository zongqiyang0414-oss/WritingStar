  await page.getByText('申请已提交，等待审核', { exact: true }).waitFor();
  let state = await storage();
  const application = state.teacherApplications.find(item => item.name === '审核测试老师');
  assert.equal(application.status, 'pending');
  assert.ok(!state.loginCredentials.some(item => item.personId === application.teacherId));
