  assert.deepEqual(errors, []);
  console.log('v0.27 browser passed: teacher application/review/issued login, own class creation, real XLSX and DOCX pickers/imports, credential CSV, persistence, title/requirements/illustration publishing, generated card preview, student credential login and responsive widths.');
} catch (error) { await qaPage?.screenshot({ path: 'outputs/v027-browser-failure.png', fullPage: true }); console.log(await qaPage?.locator('body').innerText()); throw error; } finally { await browser?.close(); }
